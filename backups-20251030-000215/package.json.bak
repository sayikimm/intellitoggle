{
  "name": "intellitoggle",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tailwind:init": "node ./scripts/tailwind-init.cjs",
    "tailwind:build": "tailwindcss -i ./assets/css/main.css -o ./public/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./assets/css/main.css -o ./public/tailwind.css -w"
  },
  "dependencies": {
    "nuxt": "^4.2.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16",
    "tailwindcss": "^4.1.16",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
