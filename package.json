{
  "name": "intellitoggle",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "tailwind:init": "node ./scripts/tailwind-init.cjs",
    "tailwind:build": "tailwindcss -i ./assets/css/tailwind.css -o ./public/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./assets/css/tailwind.css -o ./public/tailwind.css -w"
  },
  "dependencies": {
    "nuxt": "^4.2.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "tailwindcss": "^3.3.2",
    "postcss": "^8.4.20",
    "autoprefixer": "^10.4.13",
    "vite": "^4.4.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}